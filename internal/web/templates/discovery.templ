templ DiscoveryRunsTable(rows []queries.DiscoveryRun) {
	if len(rows) == 0 {
		<p>No discovery runs.</p>
	} else {
		<table>
			<thead><tr><th>ID</th><th>Kind</th><th>Status</th><th>Source</th><th>Subscription</th><th>Created</th><th>Error</th></tr></thead>
			<tbody>
				for _, row := range rows {
					<tr>
						<td>{ strconv.FormatInt(row.ID, 10) }</td>
						<td>{ row.Kind }</td>
						<td>{ row.Status }</td>
						<td>{ nullInt(row.SourceID) }</td>
						<td>{ nullInt(row.SubscriptionID) }</td>
						<td>{ strconv.FormatInt(row.CreatedAt, 10) }</td>
						<td>{ nullStr(row.ErrorKind) }</td>
					</tr>
				}
			</tbody>
		</table>
	}
