package templates

import (
	"strconv"

	"github.com/xmm2022/echo/internal/store/queries"
)

templ DiscoveryPanels() {
	<section>
		<h2>Discovery subscriptions</h2>
		<div data-reload="true" hx-get="/ui/discovery/subscriptions" hx-trigger="load, reload" hx-target="this">Loading</div>
	</section>
	<section>
		<h2>Discovery sources</h2>
		<div data-reload="true" hx-get="/ui/discovery/sources" hx-trigger="load, reload" hx-target="this">Loading</div>
	</section>
	<section>
		<h2>Producer profiles</h2>
		<div data-reload="true" hx-get="/ui/discovery/producer-profiles" hx-trigger="load, reload" hx-target="this">Loading</div>
	</section>
	<section>
		<h2>Rule profiles</h2>
		<div data-reload="true" hx-get="/ui/discovery/rule-profiles" hx-trigger="load, reload" hx-target="this">Loading</div>
	</section>
	<section>
		<h2>Discovery candidates</h2>
		<div data-reload="true" hx-get="/ui/discovery/candidates" hx-trigger="load, reload" hx-target="this">Loading</div>
	</section>
	<section>
		<h2>Discovery matches</h2>
		<div data-reload="true" hx-get="/ui/discovery/matches" hx-trigger="load, reload" hx-target="this">Loading</div>
	</section>
	<section>
		<h2>Discovery runs</h2>
		<div data-reload="true" hx-get="/ui/discovery/runs" hx-trigger="load, reload" hx-target="this">Loading</div>
	</section>
}

templ DiscoverySubscriptionsTable(rows []queries.DiscoverySubscription) {
	if len(rows) == 0 {
		<p>No discovery subscriptions.</p>
	} else {
		<table>
			<thead><tr><th>ID</th><th>Owner</th><th>Title</th><th>TMDB</th><th>Media</th><th>Status</th><th>Next check</th></tr></thead>
			<tbody>
				for _, row := range rows {
					<tr>
						<td>{ strconv.FormatInt(row.ID, 10) }</td>
						<td>{ row.OwnerID }</td>
						<td>{ row.TitleSnapshot }</td>
						<td>{ row.TmdbID }</td>
						<td>{ row.MediaType }</td>
						<td>{ row.Status }</td>
						<td>{ nullInt(row.NextCheckAt) }</td>
					</tr>
				}
			</tbody>
		</table>
	}
}

templ DiscoverySourcesTable(rows []queries.DiscoverySource) {
	if len(rows) == 0 {
		<p>No discovery sources.</p>
	} else {
		<table>
			<thead><tr><th>ID</th><th>Kind</th><th>Name</th><th>Enabled</th><th>State</th><th>Next run</th><th>Last error</th></tr></thead>
			<tbody>
				for _, row := range rows {
					<tr>
						<td>{ strconv.FormatInt(row.ID, 10) }</td>
						<td>{ row.Kind }</td>
						<td>{ row.Name }</td>
						<td>{ strconv.FormatInt(row.Enabled, 10) }</td>
						<td>{ row.SchedulerState }</td>
						<td>{ nullInt(row.NextRunAt) }</td>
						<td>{ nullStr(row.LastErrorKind) }</td>
					</tr>
				}
			</tbody>
		</table>
	}
}

