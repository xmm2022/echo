templ DiscoveryCandidatesTable(rows []queries.ListDiscoveredResourcesRedactedRow) {
	if len(rows) == 0 {
		<p>No discovery candidates.</p>
	} else {
		<table>
			<thead><tr><th>ID</th><th>Source</th><th>Provider</th><th>Title</th><th>TMDB</th><th>Status</th><th>Last seen</th></tr></thead>
			<tbody>
				for _, row := range rows {
					<tr>
						<td>{ strconv.FormatInt(row.ID, 10) }</td>
						<td>{ strconv.FormatInt(row.SourceID, 10) }</td>
						<td>{ row.Provider }</td>
						<td>{ nullStr(row.Title) }</td>
						<td>{ nullStr(row.TmdbID) }</td>
						<td>{ row.Status }</td>
						<td>{ strconv.FormatInt(row.LastSeenAt, 10) }</td>
					</tr>
				}
			</tbody>
		</table>
	}
}

