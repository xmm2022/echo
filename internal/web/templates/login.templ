package templates

templ Login(next string) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>Echo Login</title>
			<script src="/static/app.js"></script>
		</head>
		<body>
			<main>
				<h1>Echo</h1>
				<form id="login-form" method="post" action="/api/session/login" data-next={ next }>
					<p>
						<label for="login-username">Username</label>
						<input id="login-username" name="username" type="text" autocomplete="username" required autofocus/>
					</p>
					<p>
						<label for="login-password">Password</label>
						<input id="login-password" name="password" type="password" autocomplete="current-password" required/>
					</p>
					<p id="login-error" role="alert" hidden>Sign in failed.</p>
					<button type="submit">Sign in</button>
				</form>
			</main>
		</body>
	</html>
}
