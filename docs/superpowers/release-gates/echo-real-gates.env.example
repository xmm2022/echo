# Echo real release gate environment template.
#
# Usage:
#   cp docs/superpowers/release-gates/echo-real-gates.env.example .env.real-gates.local
#   $EDITOR .env.real-gates.local
#   set -a; source .env.real-gates.local; set +a
#
# Do not paste secret values into chat. Put secrets in files under
# ECHO_DISCOVERY_SECRETS_ROOT or local private paths, then fill refs/paths here.

###############################################################################
# Shared real sidecar settings
###############################################################################

# OpenList / CAS sidecar base URL reachable from this machine.
ECHO_TEST_SIDECAR_URL=http://127.0.0.1:5244

# Raw sidecar token. This file is gitignored after copying to .env.real-gates.local.
ECHO_TEST_SIDECAR_TOKEN=

# Optional: required sidecar version/commit. Leave empty to accept any version.
ECHO_TEST_SIDECAR_MIN_VERSION=

# 115 mount path as exposed by the sidecar.
ECHO_TEST_115_STORAGE_MOUNT=/115-main

###############################################################################
# Real 115 gate
#
# Choose ONE mode:
#   A) Existing CAS tree: fill ECHO_TEST_115_CAS_TREE + ECHO_TEST_115_MANIFEST
#   B) Producer path: fill ECHO_TEST_115_BINARY + ECHO_TEST_115_SHARE_URL +
#      ECHO_TEST_115_COOKIE_FILE
###############################################################################

# Mode A: pre-generated CAS tree and manifest.
ECHO_TEST_115_CAS_TREE=
ECHO_TEST_115_MANIFEST=

# Optional for Mode A: maximum staged file size in bytes.
ECHO_TEST_115_MAX_SIZE_BYTES=2000000000

# Mode B: run real 115share2cas producer.
ECHO_TEST_115_BINARY=
ECHO_TEST_115_SHARE_URL=
ECHO_TEST_115_COOKIE_FILE=

# Optional for Mode B.
ECHO_TEST_115_RECEIVE_CODE=
ECHO_TEST_115_MODE=transfer-batch
ECHO_TEST_115_LIMIT=1
ECHO_TEST_115_TIMEOUT=30m

###############################################################################
# Discovery real gate
###############################################################################

ECHO_REAL_DISCOVERY_GATE=1

# Root directory for ref: secrets below. Example layout:
#   /secure/echo-gate-secrets/
#     telegram/api_hash.txt
#     telegram/session.json
#     tmdb/api_key.txt
#     115/cookie.txt
#     115/recycle.txt
ECHO_DISCOVERY_SECRETS_ROOT=

# Telegram API credentials and existing authorized session file.
ECHO_DISCOVERY_TG_API_ID=
ECHO_DISCOVERY_TG_API_HASH_REF=ref:telegram/api_hash.txt
ECHO_DISCOVERY_TG_SESSION_REF=ref:telegram/session.json

# Controlled private channel containing one pinned/known 115 share message.
ECHO_DISCOVERY_TG_CHANNEL=

# TMDB movie id and API key ref. The real gate currently exercises movie details.
ECHO_DISCOVERY_TMDB_ID=
ECHO_DISCOVERY_TMDB_API_KEY_REF=ref:tmdb/api_key.txt

# Discovery producer/account/library settings.
ECHO_DISCOVERY_115_ACCOUNT_ID=real-115
ECHO_DISCOVERY_115_SIDECAR_ID=default
ECHO_DISCOVERY_115_STORAGE_MOUNT=/115-main
ECHO_DISCOVERY_SIDECAR_BASE_URL=http://127.0.0.1:5244

# Name of the environment variable containing the sidecar token.
# Usually keep this as ECHO_TEST_SIDECAR_TOKEN from the shared section above.
ECHO_DISCOVERY_SIDECAR_TOKEN_ENV=ECHO_TEST_SIDECAR_TOKEN

# Writable output root where the gate expects v0.1 ingest to write .echo files.
ECHO_DISCOVERY_LIBRARY_OUTPUT_PATH=

# Real producer binary and secret refs.
ECHO_DISCOVERY_115SHARE2CAS_BIN=
ECHO_DISCOVERY_115_COOKIE_REF=ref:115/cookie.txt
ECHO_DISCOVERY_115_RECYCLE_REF=ref:115/recycle.txt

# Optional: keep small to bound Telegram history scan.
ECHO_DISCOVERY_HISTORY_LIMIT=50

###############################################################################
# Emby real gate notes
#
# The repo currently has a manual v0.2 Emby release-gate document, not an
# automated TestRealEmby implementation. Fill these only if we are going to run
# the manual Emby gate/checklist against your configured local services.
###############################################################################

ECHO_REAL_EMBY=1
ECHO_GATE_ECHO_URL=http://127.0.0.1:18080
ECHO_GATE_EMBY_URL=http://127.0.0.1:8096
ECHO_GATE_EMBY_CLIENT_URL=http://127.0.0.1:18080/emby
EMBY_API_KEY=

# Optional notes for the manual gate.
ECHO_GATE_EMBY_MAPPED_ITEM_ID=
ECHO_GATE_EMBY_UNMAPPED_ITEM_ID=
ECHO_GATE_EMBY_MEDIA_ROOT=
