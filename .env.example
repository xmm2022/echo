# Copy to .env and fill in before `docker compose -f docker-compose.example.yml up`.

# Echo admin bearer token. Required — Echo refuses to start with an empty token.
# Paste this same value into the dashboard at / to use the UI.
ECHO_ADMIN_TOKEN=change-me-to-a-long-random-string

# OpenList sidecar admin token. Until this matches the sidecar's configured
# token, sidecar calls fail and /readyz reports 503 (this is expected).
ECHO_SIDECAR_TOKEN=
