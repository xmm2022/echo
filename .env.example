# Copy to .env and fill in before `docker compose -f docker-compose.example.yml up`.

# Operator bootstrap token. Used ONLY to mint admin API tokens (including
# recovery after all admin tokens are lost). Echo refuses to start without it.
# It does NOT authenticate ordinary /api or /ui requests — those use DB-backed
# API tokens minted through the bootstrap endpoint.
ECHO_BOOTSTRAP_ADMIN_TOKEN=change-me-bootstrap-token

# OpenList sidecar admin token. Until this matches the sidecar's configured
# token, sidecar calls fail and /readyz reports 503 (this is expected).
ECHO_SIDECAR_TOKEN=change-me-sidecar-token

# Emby API key, referenced by emby_proxy.upstream.api_key_ref: "env:EMBY_API_KEY".
EMBY_API_KEY=change-me-emby-api-key
